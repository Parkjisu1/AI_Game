# docker compose --env-file .env.compose 로 읽는 값. 사무실 Ubuntu 에서는 기본 포트로, 검증(WSL2 공존)에서는 아래처럼 다른 포트로.
DATA_ROOT=/data/newplay
WEB_PORT=3100
MONGO_PORT=27019
QDRANT_PORT=6353
OLLAMA_PORT=11435
# 컨테이너 실행 사용자 = 호스트 사용자 (볼륨 파일 소유권). DOCKER_GID 는 `getent group docker | cut -d: -f3`
HOST_UID=1000
HOST_GID=1000
DOCKER_GID=999
